# Copie este arquivo para .env.local e preencha. NUNCA publique o .env.local.

# --- Supabase (Project Settings > API) ---
# Estas duas são públicas (vão para o navegador):
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui

# Estas duas são SECRETAS (só no servidor):
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui
# Project Settings > API > JWT Settings > JWT Secret (legacy)
SUPABASE_JWT_SECRET=cole-o-jwt-secret-aqui

# --- IA (console.anthropic.com > API Keys) --- SECRETA
ANTHROPIC_API_KEY=sk-ant-...
# Modelo usado pela IA (troque quando quiser)
AI_MODEL=claude-haiku-5-5

# --- Limites (opcionais) ---
AI_CONTEXT_MESSAGES=40
AI_MAX_OUTPUT_TOKENS=800
MESSAGE_MAX_CHARS=2000
RATE_LIMIT_MESSAGES_PER_MINUTE=12
MAX_PARTICIPANTS_PER_ROOM=10
